{
  "manifest_version": 3,
  "name": "YouTube Subscriptions & Watch Later",
  "short_name": "Subs & Watch Later",
  "version": "0.2.0",
  "description": "Chronological list view for the subscriptions feed without Shorts or \"Most relevant\", Watch Later buttons on every video, and one-click removal on the Watch Later page.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_start",
      "css": ["src/styles.css"],
      "js": ["src/content.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/page.js"]
    }
  ],
  "action": {
    "default_title": "YouTube Subscriptions & Watch Later",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
