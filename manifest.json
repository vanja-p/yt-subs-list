{
  "manifest_version": 3,
  "name": "YouTube Subscriptions List",
  "short_name": "Subs List",
  "version": "0.1.0",
  "description": "Shows the YouTube subscriptions feed as a chronological list with Watch Later buttons, without Shorts or the \"Most relevant\" shelf.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_start",
      "css": ["src/styles.css"],
      "js": ["src/content.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/page.js"]
    }
  ],
  "action": {
    "default_title": "YouTube Subscriptions List",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
